# Copy to .env for local runs (never commit the real .env). On Render/Fly set these
# as secrets in the dashboard / `fly secrets set` instead.

# --- Slack (from api.slack.com/apps -> your app) ---
SLACK_BOT_TOKEN=xoxb-...          # OAuth & Permissions -> Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...          # Basic Information -> App-Level Tokens (scope: connections:write)

# --- Otter accounts (email + password for each) ---
OTTER_JR_EMAIL=jr-reporters@thecrimson.com
OTTER_JR_PASSWORD=
OTTER_SR_EMAIL=sr-reporters@thecrimson.com
OTTER_SR_PASSWORD=
OTTER_CONF_EMAIL=confidential@thecrimson.com
OTTER_CONF_PASSWORD=

# --- Confidential guardrails ---
# Comma-separated Slack user IDs allowed to use the Confidential account.
# Find an ID: click a person in Slack -> ... -> Copy member ID (looks like U0123ABCD).
CONF_ALLOWLIST=
CONF_REQUIRE_ALLOWLIST=true       # empty allowlist => nobody can use Confidential (safe default)

# --- Optional behaviour (sensible defaults; leave unset to accept them) ---
# POST_TRANSCRIPT=true            # post the finished transcript back into the thread
# CONF_POST_TRANSCRIPT=true       # same, for the confidential account
# CONF_POST_LINK=false            # don't echo the confidential Otter deep-link in Slack
# TRANSCRIPT_FORMAT=docx          # docx | txt | pdf | srt
# OTTER_POLL_INTERVAL=20          # seconds between "is it done yet" checks
# OTTER_POLL_TIMEOUT=2400         # give up waiting for the transcript after this many seconds
